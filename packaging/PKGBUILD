# Maintainer: Riff contributors
# PKGBUILD for Arch Linux / CachyOS
#
# Build & install from a local checkout:
#   cd packaging && makepkg -si
#
# `python-ytmusicapi` lives in the AUR — on CachyOS install it first with
# the preinstalled AUR helper:   paru -S python-ytmusicapi

pkgname=riff-player
pkgver=0.23.1
pkgrel=1
pkgdesc="Native YouTube Music player (GTK4 + libadwaita + mpv)"
arch=('any')
url="https://github.com/Aimdi/Riff"
license=('GPL-3.0-or-later')
depends=(
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
  'mpv'
  'yt-dlp'
  'python-ytmusicapi'
  'hicolor-icon-theme'
)
optdepends=(
  'python-anthropic: AI Mix — Claude-curated song suggestions'
  'gst-plugin-gtk4: in-app video for YouTube clips (Watch video on the cover art)'
  'gstreamer: required by in-app video'
  'gst-plugins-base: required by in-app video'
  'gst-plugins-good: required by in-app video'
  'gst-libav: extra codecs for in-app video'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-wheel'
  'python-setuptools'
)

# Repo root = parent of this packaging/ directory.
# IMPORTANT: use $startdir (set by makepkg), not bare `cd ..`.
# makepkg re-sources PKGBUILD after pkgver() with cwd=$srcdir, so
# `_srcdir="$(cd .. && pwd)"` would resolve to packaging/ and break build().
_pkgroot="${startdir:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"
_repodir="$(cd "$_pkgroot/.." && pwd)"

pkgver() {
  grep -oP '(?<=^__version__ = ")[^"]+' "$_repodir/riff/__init__.py"
}

build() {
  cd "$_repodir"
  # Clean stale wheels from previous builds — package() globs this
  # directory, and two wheels would collide on the same installed files.
  rm -rf "$srcdir/dist"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

package() {
  python -m installer --destdir="$pkgdir" \
    "$srcdir"/dist/riff_player-*-py3-none-any.whl

  install -Dm644 "$_repodir/data/io.github.aimdi.Riff.desktop" \
    "$pkgdir/usr/share/applications/io.github.aimdi.Riff.desktop"
  install -Dm644 "$_repodir/data/io.github.aimdi.Riff.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.aimdi.Riff.svg"
  install -Dm755 "$_repodir/packaging/riff-update" \
    "$pkgdir/usr/bin/riff-update"
  install -Dm644 "$_repodir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
